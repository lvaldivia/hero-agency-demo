{
  "name": "hero-agency-demo",
  "version": "1.0.0",
  "description": "Demo de CI/CD con Azure DevOps — temática My Hero Academia",
  "main": "src/server.js",
  "private": true,
  "engines": { "node": ">=22" },
  "scripts": {
    "start": "node src/server.js",
    "test": "node --test test/*.test.js",
    "test:ci": "node --test --test-reporter=spec --test-reporter-destination=stdout --test-reporter=./scripts/junit-reporter.js --test-reporter-destination=test-results.xml test/*.test.js",
    "release": "node scripts/set-release.js"
  },
  "dependencies": {
    "express": "^4.21.2"
  }
}
